# Settings for Deere Ops Center MCP.
#
# The tool does not read this file on its own. Use it as a list of what you can set:
#   - as environment variables (for example in the "env" part of your AI app's MCP settings), or
#   - in config.toml in the tool's config folder, using the same names in lower case without the
#     DEERE_ prefix (for example `page_cap = 20`, and `yield = "MASS"` for DEERE_YIELD).
# An environment variable wins over config.toml. Every setting is optional except the two codes,
# and `deere-mcp setup` stores those for you.
#
# The values below are placeholders. Never put real codes in a file that is shared or committed.
# The .gitignore in this project already ignores a file named .env.

# Your John Deere application's Application ID and Secret (from developer.deere.com).
# Treat the Secret like a password.
# DEERE_CLIENT_ID=your-application-id
# DEERE_CLIENT_SECRET=your-application-secret

# Which John Deere environment to talk to. Default is the sandbox shown here.
# DEERE_BASE_URL=https://sandboxapi.deere.com/platform

# Measurement system: ENGLISH (acres, bushels) or METRIC (hectares, tonnes).
# Not set means each organization's own preference in Operations Center is used.
# DEERE_UOM=ENGLISH

# How yield is expressed: VOLUME (bushels) or MASS (pounds, tonnes).
# Not set means each organization's own preference is used.
# DEERE_YIELD=VOLUME

# Port used during sign-in. Must match the Redirect URI in your John Deere application,
# which is http://localhost:<port>/callback. Change it only if 9090 is already in use.
# DEERE_CALLBACK_PORT=9090

# Most pages of results fetched for one question before the tool stops and says the list
# was cut short.
# DEERE_PAGE_CAP=20

# The only folder the tool may write files into (shapefile downloads, saved files, exports).
# Default is a deere-mcp folder in your Documents.
# DEERE_OUTPUT_DIR=/path/to/a/folder/you/choose

# How much the tool writes to its log: DEBUG, INFO, WARNING or ERROR. Tokens and data are
# never logged at any level.
# DEERE_LOG_LEVEL=WARNING
